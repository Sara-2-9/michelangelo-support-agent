# ============================================================
# Michelangelo Support Agent — variabili d'ambiente
# Copia questo file in .env e riempilo. MAI committare .env.
# ============================================================

# --- Supabase (Settings → API del tuo progetto) ---
SUPABASE_URL=https://TUO_PROJECT_REF.supabase.co
# Chiave "service_role" (NON quella anon): gira solo sul backend/script locali
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Cloudflare Workers AI ---
# Account ID: dashboard Cloudflare → Workers & Pages → sidebar destra
CLOUDFLARE_ACCOUNT_ID=
# API Token: My Profile → API Tokens → Create Custom Token
# permessi minimi: Account → Workers AI → Read (oppure il template "Workers AI")
CLOUDFLARE_API_TOKEN=
