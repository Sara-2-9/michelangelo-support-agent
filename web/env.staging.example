# Staging browser env — copy this file to `web/.env.staging` (WITH the
# leading dot) and fill in the STAGING project's values. Loaded by Vite in
# `--mode staging` (E2E tests). The publishable key is public by design.
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-publishable-key>
