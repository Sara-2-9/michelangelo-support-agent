# Browser-side Supabase config (Phase 5.3).
# These are PUBLIC by design: the anon key is safe to expose because
# Row Level Security enforces what each user can read (SELECT-only policies).
# Copy to web/.env and fill in the real values (Supabase → Settings → API).

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
